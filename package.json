{
  "name": "fe-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@types/node": "22.19.17",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.15",
    "lint-staged": "15.5.2",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "2.9.6",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored --config apps/web/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/mobile/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored --config apps/mobile/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored --config eslint.config.packages.mjs",
      "prettier --write"
    ],
    "commitlint.config.js": [
      "eslint --fix --max-warnings 0 --no-warn-ignored --config eslint.config.packages.mjs",
      "prettier --write"
    ],
    "eslint.config.packages.mjs": [
      "eslint --fix --max-warnings 0 --no-warn-ignored --config eslint.config.packages.mjs",
      "prettier --write"
    ],
    "repo.d.ts": [
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
